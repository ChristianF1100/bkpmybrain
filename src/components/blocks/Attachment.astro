---
// Blocco MDX: <Attachment href="/media/…/file.pdf" label="Scheda tecnica" />
import { withBase } from '../../lib/url.ts';
interface Props { href: string; label: string }
const { href, label } = Astro.props;
---
<p class="block-attachment">
  <a href={withBase(href)} download>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 12.5 14.5 6a3.2 3.2 0 0 1 4.5 4.5l-8 8a5 5 0 0 1-7-7l7.5-7.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
    <span>{label}</span>
  </a>
</p>
